{
  "name": "whiskynavi-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@tanstack/react-query": "^5.104.4",
    "expo": "^58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "htmlparser2": "^12.0.0",
    "lucide-react-native": "^1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "monocart-coverage-reports": "^3.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "expo export --platform web --clear && node scripts/check-production-bundle.mjs dist",
    "test:e2e:web": "node scripts/e2e.mjs full",
    "test:e2e:validate": "node scripts/check-maestro.mjs",
    "test:e2e:android": "node scripts/native-e2e.mjs android",
    "test:e2e:ios": "node scripts/native-e2e.mjs ios",
    "test:fixtures": "node e2e/fixtures/server.mjs",
    "format:check": "prettier --check src/components/native src/features src/lib src/app tests e2e scripts app.config.ts playwright.config.ts vitest.config.mts tsconfig.json package.json route-migration.json .github/workflows",
    "format": "prettier --write src/components/native src/features src/lib src/app tests e2e scripts app.config.ts playwright.config.ts vitest.config.mts tsconfig.json package.json route-migration.json .github/workflows",
    "test:e2e:doctor": "node scripts/check-native-environment.mjs",
    "api:sync": "node scripts/sync-api.mjs",
    "build:bundles": "expo export --platform all --clear && node scripts/check-production-bundle.mjs dist",
    "design:compare": "node scripts/visual-compare.mjs",
    "web:compare": "node scripts/visual-dev.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:smoke": "node scripts/e2e.mjs smoke",
    "test:e2e:routes": "node scripts/e2e.mjs routes",
    "test:e2e:stability": "node scripts/e2e.mjs stability",
    "test:e2e:build": "node scripts/web-e2e.mjs --build-only",
    "test:coverage": "vitest run --coverage",
    "test:e2e:coverage": "node scripts/e2e.mjs coverage"
  },
  "private": true
}
